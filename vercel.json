{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), accelerometer=(), gyroscope=(), magnetometer=(), payment=(), usb=(), browsing-topics=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://gc.zgo.at https://*.goatcounter.com; img-src 'self' data: https:; script-src 'self' https://gc.zgo.at https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "assistenz-ranking.com" }],
      "destination": "https://assistenz-ranking.de/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sitemap-index.xml",    "destination": "/api/sitemap-index" },
    { "source": "/sitemap.xml",          "destination": "/api/sitemap" },
    { "source": "/sitemap-kliniken.xml", "destination": "/api/sitemap-kliniken" }
  ]
}
